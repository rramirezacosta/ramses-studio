{
  "name": "ramses-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "ramses-studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:flatpak": "npm run build && electron-builder --linux flatpak",
    "package:windows": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^30.5.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.ramses.multistem",
    "productName": "Ramses Studio",
    "icon": "build/icons/app_512.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/components/stemsplitter/htdemucs_6s.onnx",
        "to": "models/htdemucs_6s.onnx"
      },
      {
        "from": "build/icons/app_512.png",
        "to": "icons/app_512.png"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "files": [
        "dist/**",
        "dist-electron/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_cuda.so",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_tensorrt.so"
      ],
      "extraResources": [
        {
          "from": "vendor/ytdlp/linux/x64/yt-dlp_linux",
          "to": "bin/yt-dlp"
        }
      ]
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "files": [
        "dist/**",
        "dist-electron/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll"
      ],
      "extraResources": [
        {
          "from": "vendor/ytdlp/win32/x64/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ]
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "baseVersion": "23.08"
    }
  }
}
